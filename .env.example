# Copia este archivo como .env (para pruebas locales con `vercel dev`) y rellena los valores.
# En producción, estas mismas variables se configuran en Vercel → Project Settings → Environment Variables.
# NUNCA subas el archivo .env real a git.

# Stripe (Developers → API keys / Developers → Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Contraseña compartida para la página oculta del curso y para los 3 vídeos de Vimeo
ACCESS_PASSWORD=TallerProductividad2025

# Secreto para firmar la cookie de sesión de la página oculta (cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# SMTP de IONOS (correo corporativo desde el que se envía el email de acceso)
IONOS_SMTP_HOST=smtp.ionos.es
IONOS_SMTP_PORT=465
IONOS_SMTP_USER=hola@lauragonzalezortizdezarate.com
IONOS_SMTP_PASS=...

# Redis (opcional pero recomendado): se rellenan solas al conectar la integración
# "Storage → Marketplace Database Providers → Upstash for Redis" desde el dashboard de Vercel
# (prefijo de variable usado: UPSTASH_REDIS_REST). Sin ellas, el sistema sigue funcionando
# pero sin protección contra emails duplicados si Stripe reintenta una notificación.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
